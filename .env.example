# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Absolute path to your knowledge repo (the devNote folder)
JARVIS_REPO_PATH=C:\Users\you\Desktop\devNote

# AI providers (free tiers). Gemini is primary, Groq is the fallback.
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Optional: override AI model lists (comma-separated, tried in order).
# Defaults live in jarvis/config.py and are kept current — you only need these
# if a provider retires a model before Jarvis is updated.
# JARVIS_GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# JARVIS_GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest
# JARVIS_AI_PRIMARY=groq
# JARVIS_LEAN_NOTES=true

# Optional integrations
YOUTUBE_API_KEY=your_youtube_data_api_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
